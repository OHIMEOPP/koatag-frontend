{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主視窗與黑板視窗的權限，檔案只能讀寫 APP 自己的資料夾",
  "windows": [
    "main",
    "board-*"
  ],
  "permissions": [
    "core:default",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    "updater:default",
    "process:allow-restart"
  ]
}
