{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KOATAG",
  "version": "0.0.2",
  "identifier": "com.koatag.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KOATAG",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["koatag"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwQzQyNjU0QzNFMDlDNDgKUldSSW5PRERWQ2JFWU95WXAva1hpZmFodmo0NWVlbDRBZFJoeW1kOURrS2svWDEwWkZ2R3Vpdk8K",
      "endpoints": [
        "https://objectstorage.ap-tokyo-1.oraclecloud.com/p/pknv_KjVgp42emaOZLhM5a3tjskZduS2wl6cncX_CiZqFV7OYMrDDvHqmom7I3qQ/n/nr27tf8xagsn/b/koatag-desktop/o/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
